{
  "schema_version": 1,
  "purpose": "Protect the public Marketech inquiry owner-notification path from mailbox and transactional-email quota exhaustion.",
  "vercel": {
    "team_id": "team_OHRkafYU5Gg6L00qcwYYsq81",
    "project_id": "prj_iRZyxQA5Gh93mcrEt7Z6XSMN7HVJ",
    "project_name": "marketech-digital"
  },
  "rule": {
    "id": "marketech-inquiry-owner-notification",
    "environment": "production",
    "method": "POST",
    "path": "/api/inquiry",
    "algorithm": "fixed_window",
    "window_seconds": 60,
    "requests_per_window": 5,
    "keys": ["ip"],
    "limit_action": "rate_limit",
    "limited_status": 429
  },
  "application_contract": {
    "sdk": "@vercel/firewall",
    "sdk_version": "1.2.5",
    "missing_rule_or_sdk_error": "fail_closed_503",
    "rate_limited": "return_429_with_retry_after_60",
    "submission_id_is_not_rate_limit_identity": true,
    "raw_client_ip_stored_by_application": false
  },
  "deployment_gate": {
    "production_rule_required": true,
    "production_rule_activation_performed_by_this_pr": false,
    "founder_approval_required_before_production_activation": true,
    "production_deployment_authorized_by_this_manifest": false
  }
}
