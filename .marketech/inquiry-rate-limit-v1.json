    "raw_client_ip_stored_by_application": false,
    "default_counting_identity": "client_ip_from_vercel_request_x_real_ip_when_rateLimitKey_is_omitted",
    "sdk_generated_waf_header": "x-vercel-rate-limit-key",
    "custom_rateLimitKey_supplied_by_site": false
  },
  "deployment_gate": {
    "production_rule_required": true,
    "production_rule_activation_performed_by_this_pr": false,
