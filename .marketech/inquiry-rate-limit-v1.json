    "production_deployment_authorized_by_this_manifest": false
  },
  "reviewed_active_waf_snapshot": {
    "observed_date_utc": "2026-11-02",
    "project_id": "prj_iRZyxQA5Gh93mcrEt7Z6XSMN7HVJ",
    "config_version": 1,
    "firewall_enabled": true,
    "rule_name": "Marketech Inquiry Protection",
    "rule_id": "rule_marketech_inquiry_protection_uso6qJ",
    "condition_rate_limit_api_id": "marketech-inquiry-owner-notification",
    "counting_keys": [
      "header:x-vercel-rate-limit-key"
    ],
    "key_mapping": "The application supplies only {request}; Vercel Firewall SDK defaults rateLimitKey to the request IP, then forwards a derived key via x-vercel-rate-limit-key for WAF counting. The manifest rule.keys=[ip] records intended logical identity, not literal WAF keys serialization.",
